# ═══════════════════════════════════════════════════════════
#  OKX API 凭据模板 —— 复制成 .env 后填
#  获取：OKX 网页 → 头像 → API → 创建 API Key
#  权限：勾「交易」，不要勾「提币」，强烈建议绑定 IP
#  创建后 API Key / Secret / Passphrase 只显示一次，立刻保存
#  模拟盘：先在 OKX 切到「模拟交易」，在模拟环境里另建一套 key，OKX_SIMULATED=1
#  实盘：OKX_SIMULATED=0
# ═══════════════════════════════════════════════════════════

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_SIMULATED=1
